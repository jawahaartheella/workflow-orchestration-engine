# ========================================================
# FlowForge Workflow Orchestration Engine - Environment Config
# ========================================================

# Backend Port (assigned automatically by cloud platforms like Render / Railway)
PORT=3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/workflow_engine?retryWrites=true&w=majority

# Optional Redis Configuration (defaults to in-process execution fallback if not configured)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional Frontend Configuration (for Vercel / Netlify / Render frontend deployment)
# VITE_API_URL=https://<your-backend-domain>.onrender.com/api
# VITE_SOCKET_URL=https://<your-backend-domain>.onrender.com
